 HotStasher
 2026 ABATBeliever (https://abatbeliever.net/software/bin/HotStasher)
*/
//===================================================================================

#packopt version "Build.ini" //詳細
#packopt icon "app.ico"		 //アイコン

#define ctype HIWORD(%1) (%1 >> 16 & $FFFF)
#include "hspinet.as"		//ネット通信
#include "mod_rss.as"		//RSS用
#include "mod_regexp.as"	//正規表現一括変換
#include "hsp3cl.as"

AppName = "HotStasher"
AppVer  = "1.0"

onerror *HandleErr
onexit *exit

//////////////////////////////////////////////////////////////////
//パースとモード確定

//引数分解
#include "lib_argParser.hsp"
if args(0)="" : args(0)="-h"

dim mode    : mode  =0
sdim target : target=""
dim format  : format=0
dim detail  : detail=1

repeat length(args)
	sdim tmp
	tmp=args(cnt)
	if tmp="-v"{
		mes AppName+" "+AppVer
		goto *exit
	}

	if tmp="-h"{
		mes AppName+" ヘルプ\n"
		mes "Usage:\n  HotStasher target=○○ [mode=○○] [format=○○] [detail=○○]\n"
		mes "Option:\n  -h          このヘルプを表示\n  -v          バージョンを表示\n  -U          更新確認\n"
		mes "  target=○○   入力先（必須、空白が入る場合「\"」で囲ってください）\n    URL              URLを直接指定（<&>で複数指定可）\n    ファイルパス     ファイル内のURLを使用\n"
		mes "  mode=○○     処理モード\n    url              URLとして処理（デフォルト）\n    rss              RSS/Atomフィードとして処理\n"
		mes "  format=○○   出力形式\n    out              標準出力（デフォルト）\n    txt              テキストファイル出力\n    md               Markdown風ファイル出力\n    say              SAPIによる音声出力\n"
		mes "  detail=○○   処理状況の表示\n    true             表示する（デフォルト）\n    false            表示しない"
		goto *exit
	}

	if tmp="-U"{
		goto *Checking_Update
		goto *exit
	}

	sdim arg
	sdim txt
	split tmp,"=",arg,txt
	if length(txt)!=0{
		input_data=txt(0)
		repeat length(txt)-1
			input_data+="="+txt(cnt+1)
		loop
	}else{
		input_data=""
	}
	
	switch arg
		case "mode"
			dim mode
			mode=0
			if input_data="url" {mode=0}
			if input_data="rss" {mode=1}
			swbreak

		case "target"
			sdim target
			target=input_data
			swbreak

		case "format"
			dim format
			format=0
			if input_data="out" {format=0}
			if input_data="txt" {format=1}
			if input_data="md"  {format=2}
			if input_data="say"  {format=3}
			swbreak

		case "detail"
			dim detail
			detail=1
			if input_data="false" {detail=0}
			swbreak

		default
			mes AppName+" v"+AppVer+" | 解釈できない引数です("+str(tmp)+")"
			goto *exit
			swbreak
	swend
loop

//TARGETの解析

if target=""{
	mes AppName+" v"+AppVer+" | TARGET引数が指定されていません"
	goto *exit
}

if instr(target,0,"http")=0{
	split target,"<&>",target
	dim flag : flag=0			//初回の1つめの代入用
	sdim LoadList
	repeat length(target)
		if target(cnt)!="" and instr(target(cnt),0,"http")=0{
			if flag{
				LoadList(length(LoadList))=target(cnt)
			}else{
				LoadList(0)=target(cnt)
				flag=1
			}
		}
	loop
//	LoadList=target		//直接URLが指定されている場合これを選ぶ
}else{
	exist target		//ファイル指定の場合
	if strsize=-1{
		mes AppName+" v"+AppVer+" | TARGET引数で指定された対象に到達できません(ローカルファイル)"
		goto *exit
	}else{
		sdim TARGET_File_buffer
		notesel TARGET_File_buffer
		noteload target
		dim flag : flag=0		//初回の1つめの代入用
		sdim LoadList		
		repeat notemax
			sdim tmp
			noteget tmp,cnt
			if instr(tmp,0,"http")=0{
				if flag{
					LoadList(length(LoadList))=tmp
				}else{
					LoadList(0)=tmp
					flag=1
				}
			}
		loop
		noteunsel
	}
}

if mode=1{		//rss
	sdim RSSLoadList
	repeat length(LoadList)
		 RSSLoadList(cnt)=LoadList(cnt)
	loop
	sdim LoadList
	dim flag : flag=0		//初回の1つめの代入用
	repeat length(RSSLoadList)
		sdim RSSLoadResult	//仮のURLリスト入れ場の初期化
		sdim dummy			//RSSの内容用
		if detail {mes "[RSS] "+RSSLoadList(cnt)+" から抽出...",1}
		rssload dummy,RSSLoadResult,RSSLoadList(cnt),65535
		if stat=0{
			repeat length(RSSLoadResult)
				if flag{
					LoadList(length(LoadList))=RSSLoadResult(cnt)
				}else{
					LoadList(0)=RSSLoadResult(0)
					flag=1
				}
			loop
		}
		if detail {mes "終了("+str(length(RSSLoadResult))+"件)"}
	loop
}

sdim WebPageRawData,,length(LoadList)	//アクセス後のデータ収集用

repeat length(LoadList)
	if detail {mes "[INFO] "+LoadList(cnt)+" を処理...",1}
	sdim target
	target=LoadList(cnt)

	if format!=1{	//txtではないなら整形を行い、そうでないなら整形はなし
		WebPageRawData(cnt)=DataFetch(target,1)
	}else{
		WebPageRawData(cnt)=DataFetch(target,0)
	}
	if detail {mes "終了"}
		
loop

if format=0 or format=3{
	repeat length(WebPageRawData)
		if format=0{
			mes WebPageRawData(cnt)
		}else{
			newcom spv, "Sapi.SpVoice"
			if varuse(spv)=0 {
				mes AppName+" v"+AppVer+" | SAPIを初期化できませんでした"
				goto *exit
			}else{
			if detail {mes "SAPIを利用し発話を開始します、Ctrl+Cで中断 ("+LoadList(cnt)+")"}
			spv->"Speak" WebPageRawData(cnt),0
			}
		}
	loop
}else{							//txtまたはmd
	sdim OUTPUT_File_buffer
	repeat length(WebPageRawData)
		OUTPUT_File_buffer+="\n\n--- "+LoadList(cnt)+" ---\n"+WebPageRawData(cnt)
	loop
	notesel OUTPUT_File_buffer
	if format=1{
		notesave ""+dir_cur+"\\out.txt"
		if detail {mes ""+dir_cur+"\\out.txt に出力しました"}
	}else{
		notesave ""+dir_cur+"\\out.md"
		if detail {mes ""+dir_cur+"\\out.md  に出力しました"}
	}
	noteunsel
}
stop

#include "InternetManager.hsp"
#include "DataFetchManager.hsp"
#include "cnvUTF2ANSI.hsp"

*exit
end

*HandleErr
	mes AppName+" v"+AppVer+" | HSP3内部エラー(#"+strf("%02d",wparam)+")が起こりました"
	goto *exit