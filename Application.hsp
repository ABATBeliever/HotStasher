//===================================================================================

#packopt version "Build.ini" //詳細
#packopt icon "app.ico"		 //アイコン

#define ctype HIWORD(%1) (%1 >> 16 & $FFFF)
#include "hspinet.as"		//ネット通信
#include "mod_rss.as"		//RSS用
#include "mod_regexp.as"	//正規表現一括変換
#include "hsp3cl.as"

AppName = "HotStasher"
AppVer  = "0.3"

onerror *HandleErr
onexit *exit

//////////////////////////////////////////////////////////////////
//パースとモード確定

//引数分解
#include "lib_argParser.hsp"
if args(0)="" : args(0)="-h"
/*
mes "CMDLINE: '"+cmdline+"'"

mes "ArgParser Begin"
repeat length(args)
	mes str(cnt)+": "+args(cnt)
loop
mes "ArgParser END\n"
*/
newcom spv, "Sapi.SpVoice"/*
if varuse(spv)=0 {
	mes "SAPI: False"
}else{
	mes "SAPI: True"
}

mes "LoadSetting Begin"
*/
dim mode
sdim target : target="null"
dim format

repeat length(args)
	sdim tmp
	tmp=args(cnt)
	if tmp="-v"{
		mes AppName+" "+AppVer
		goto *exit
	}

	if tmp="-h"{
		mes AppName+{" ヘルプ

・'-h' をつけるか引数をつけず実行すると、このヘルプを表示します
・'-v' をつけると、バージョンを表示します
・'-U' をつけると、更新確認を行います
------------------------------------------------------------------------------------------
基本構文
 "}+AppName+{" target=○○ mode=○○ format=○○
------------------------------------------------------------------------------------------
 target
  入力形式について、必須
   URL(https://~)        : そのURLを直接利用します、「<&>」で区切ることで複数指定可能
   ローカルパス(○:\//~) : そのパスにあるファイルをテキストとして中身のURLを利用します

 mode
  処理形式について、オプション指定
   url  : 直接処理モードを指定   (こちらがデフォルト)
   rss  : RSSフィードモードを指定

 format
  出力形式について、オプション指定
   out : 標準出力に出力          (こちらがデフォルト)
   txt : テキストファイルとして出力
   md  : マークダウン風ファイルとして出力
   say : SAPIで音声出力
------------------------------------------------------------------------------------------
"}
		goto *exit
	}

	if tmp="-U"{
		goto *Checking_Update
		goto *exit
	}

	sdim arg
	sdim txt
	split tmp,"=",arg,txt
	if length(txt)!=0{
		input_data=txt(0)
		repeat length(txt)-1
			input_data+="="+txt(cnt+1)
		loop
	}else{
		input_data=""
	}
	
	switch arg
		case "mode"
			dim mode
			mode=0
			if input_data="url" {mode=0}
			if input_data="rss" {mode=1}
			swbreak

		case "target"
			sdim target
			target=input_data
			swbreak

		case "format"
			dim format
			format=0
			if input_data="out" {format=0}
			if input_data="txt" {format=1}
			if input_data="md"  {format=2}
			if input_data="say"  {format=3}
			swbreak

		default
			mes "解釈できない引数です : "+str(tmp)
			swbreak
	swend
loop

//TARGETの解析

if instr(target,0,"http")=0{
	split target,"<&>",target
	dim flag : flag=0			//初回の1つめの代入用
	sdim LoadList
	repeat length(target)
		if target(cnt)!="" and instr(target(cnt),0,"http")=0{
			if flag{
				LoadList(length(LoadList))=target(cnt)
			}else{
				LoadList(0)=target(cnt)
				flag=1
			}
		}
	loop
//	LoadList=target		//直接URLが指定されている場合これを選ぶ
}else{
	exist target		//ファイル指定の場合
	if strsize=-1{
		mes "[0x52] "+AppName+" v"+AppVer+" terminated abnormally [target file not found]"
	}else{
		sdim TARGET_File_buffer
		notesel TARGET_File_buffer
		noteload target
		dim flag : flag=0		//初回の1つめの代入用
		sdim LoadList		
		repeat notemax
			sdim tmp
			noteget tmp,cnt
			if instr(tmp,0,"http")=0{
				if flag{
					LoadList(length(LoadList))=tmp
				}else{
					LoadList(0)=tmp
					flag=1
				}
			}
		loop
		noteunsel
	}
}

sdim WebPageRawData,,length(LoadList)	//アクセス後のデータ収集用

repeat length(LoadList)
	mes "処理: "+LoadList(cnt)
	sdim target
	target=LoadList(cnt)

	if format!=1{	//txtではないなら整形を行い、そうでないなら整形はなし
		WebPageRawData(cnt)=DataFetch(target,1)
	}else{
		WebPageRawData(cnt)=DataFetch(target,0)
	}
		
loop

if format=0 or format=3{
	repeat length(WebPageRawData)
		if WebPageRawData(cnt)!=-1 and WebPageRawData(cnt)!=-2{
			if format=0{
				mes WebPageRawData(cnt)
			}else{
				spv->"Speak" WebPageRawData(cnt),0
			}
		}
	loop
}else{							//txtまたはmd
	sdim OUTPUT_File_buffer
	repeat length(WebPageRawData)
		if WebPageRawData(cnt)!=-1 and WebPageRawData(cnt)!=-2{
			OUTPUT_File_buffer+="\n\n--- "+LoadList(cnt)+" ---\n"+WebPageRawData(cnt)
		}else{
			OUTPUT_File_buffer+="\n\n--- "+LoadList(cnt)+" ---\n取得に失敗"
		}
	loop
	notesel OUTPUT_File_buffer
	if format=1{
		notesave ""+dir_cur+"\\out.txt"
	}else{
		notesave ""+dir_cur+"\\out.md"
	}
	noteunsel
}
stop

#include "InternetManager.hsp"
#include "DataFetchManager.hsp"
#include "cnvUTF2ANSI.hsp"

*exit
end

*HandleErr
	mes "[0x"+strf("%04d]",wparam)+" "+AppName+" v"+AppVer+" terminated abnormally [HSP Error]"
	goto *exit