//すでにvarにはHTMLが入っているものとして

// h1～h4 → Markdown見出し
var = replace(var, "<h1\\b[^>]*>(.*?)</h1\\s*>", "# $1\n")
var = replace(var, "<h2\\b[^>]*>(.*?)</h2\\s*>", "## $1\n")
var = replace(var, "<h3\\b[^>]*>(.*?)</h3\\s*>", "### $1\n")
var = replace(var, "<h4\\b[^>]*>(.*?)</h4\\s*>", "#### $1\n")

// a → Markdownリンク
var = replace(var, "<a\\b[^>]*href\\s*=\\s*[\"']([^\"']+)[\"'][^>]*>(.*?)</a\\s*>", "[$2]($1)")

// script / style / コメントを除去
var = replace(var, "<script\\b[^>]*>[\\s\\S]*?</script\\s*>", "")
var = replace(var, "<style\\b[^>]*>[\\s\\S]*?</style\\s*>", "")
var = replace(var, "<!--[\\s\\S]*?-->", "")

// HTMLタグを除去
var = replace(var, "<[^>]*>", "")

// 横方向の空白だけ整理
var = replace(var, "[ \\t]+", " ")

notesel var

flag = 0
sdim new_var

repeat notemax
	sdim tmp
	noteget tmp,cnt
	strrep tmp," ",""
	strrep tmp,"　",""
	if tmp="" {
		if flag >= 2{
			continue
		}else{
			flag++
		}
	}else{
		flag = 0
	}
	noteget tmp,cnt
	new_var+="\n"+tmp
loop

mesbox new_var,640,480