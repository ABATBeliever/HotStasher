<script>
document.addEventListener("DOMContentLoaded", function(){
  var currentOpenTab = null;

  document.querySelectorAll(".nav-tab-btn").forEach(function(btn) {
    btn.addEventListener("click", function() {
      if (btn.dataset.url) {
        location.href = btn.dataset.url;
        return;
      }

      var tabKey = btn.dataset.tab;
      var subMenu = document.getElementById("nav-sub-" + tabKey);
      if (!subMenu) return;

      var isOpen = subMenu.classList.contains("active");

      document.querySelectorAll(".nav-tab-btn").forEach(function(b) { b.classList.remove("active"); });
      document.querySelectorAll(".nav-sub-menu").forEach(function(m) {
        m.classList.remove("active");
      });

      if (!isOpen) {
        btn.classList.add("active");
        subMenu.classList.add("active");
        currentOpenTab = tabKey;
      } else {
        currentOpenTab = null;
      }
    });
  });
});
</script>

