*Checking_Update
	exist "hspinet.dll"
	if strsize=-1{
		mes AppName+" v"+AppVer+" | hspinet.dllが見つかりません"
		goto *exit
	}
	netinit
	if stat {
		mes AppName+" v"+AppVer+" | hspinetの初期化に失敗しました"
		goto *exit
	}
	netagent ""+AppName+"/"+AppVer
	neturl "https://abatbeliever.net/upd/"+AppName+"/win-x86"
	netrequest_get ""
	mes "更新を確認中 (https://abatbeliever.net/upd/"+AppName+"/win-x86)"
	repeat 64
		mes ".",1
		dim res
		netexec res
		if res>0 {
			netgetv dat
			if strlen(dat)>512 {
				mes "\n"+AppName+" v"+AppVer+" | 更新確認サーバからの応答が不正です(長すぎます)"
				goto *exit
			}
			split dat,",",dat
			if dat(0)!="[HotStasher]"{
				mes "\n"+AppName+" v"+AppVer+" | 更新確認サーバからの応答が不正です(ヘッダー不良)"
				goto *exit
			}
			if length(dat)!=3{
				mes "\n"+AppName+" v"+AppVer+" | 更新確認サーバからの応答が不正です(Syntaxエラー)"
				goto *exit
			}
			if AppVerInt!=dat(1) {
				mes "更新があります！\n"+dat(2)+"\nhttps://abatbeliever.net/software/"+AppName+"/ よりダウンロード"
				goto *exit
			}else{
				mes "お使いのバージョンは最新版です"
				goto *exit
			}
			break
		}

		if res<0 {
			neterror dat
			mes "\n"+AppName+" v"+AppVer+" | 更新確認サーバに接続できませんでした("+dat+")"
			goto *exit
		}
		await 30
		if cnt=15 {
			mes "\n"+AppName+" v"+AppVer+" | 更新確認サーバに接続できませんでした(タイムアウト)"
			goto *exit
		}
	loop
goto *exit