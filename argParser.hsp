cmdline = dir_cmdline
argc = 0
token = ""
inQuote = 0

repeat strlen(cmdline)
    c = strmid(cmdline, cnt, 1)
    if c = "\"" {
        inQuote = 1 - inQuote
        continue
    }
    if c = " " & inQuote = 0 {
        if strlen(token) > 0 {
            args(argc) = token
            argc++
            token = ""
        }
    } else {
        token += c
    }
loop

if strlen(token) > 0 {
    args(argc) = token
    argc++
}


